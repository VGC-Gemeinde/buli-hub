# Copy to .env.local and fill in. Local values: `supabase status -o env`
# (PUBLISHABLE_KEY and SECRET_KEY entries).

# Direct Postgres connection (Drizzle; local Supabase default shown)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase client (Auth via Discord OAuth)
# New API key model: sb_publishable_... replaces the anon key,
# sb_secret_... replaces the service_role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... from `supabase status`>
SUPABASE_SECRET_KEY=<sb_secret_... from `supabase status`>

# Discord REST API (bot token — server-side only, never expose to the client)
DISCORD_BOT_TOKEN=<dev bot token>

# --- .env (not .env.local) ---
# The Supabase CLI substitutes these into supabase/config.toml on
# `supabase start`. Values: Discord Developer Portal → OAuth2.
# SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=""
# SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=""

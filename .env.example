# Copy to .env and fill in. One file for everything local — read by Next.js,
# drizzle-kit, and the Supabase CLI alike.
# Supabase values: `supabase status -o env` (DB_URL, PUBLISHABLE_KEY, SECRET_KEY).

# --- Read by the app / drizzle-kit ---

# Direct Postgres connection (Drizzle; local Supabase default shown)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase client (Auth via Discord OAuth)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<sb_publishable_... from `supabase status`>"
SUPABASE_SECRET_KEY="<sb_secret_... from `supabase status`>"

# Discord REST API (bot token — server-side only, never expose to the client)
DISCORD_BOT_TOKEN="<dev bot token>"

# Optional: comma-separated hosts allowed to reach the dev server cross-origin
# (e.g. your phone on the LAN at http://192.168.x.x:3000). Without it, Next dev
# blocks cross-origin HMR/assets and the page loads but never hydrates.
DEV_LAN_ORIGIN=""

# Discord results channel — match results and MotW VOD announcements are
# posted here and kept in sync (edited/deleted with the result). Unset →
# posting is skipped entirely, so local dev stays silent.
DISCORD_RESULTS_CHANNEL_ID=""

# Public base URL of the hub (no trailing slash) — used for the „Zum Match"
# links in Discord posts. Unset → posts carry no hub link.
APP_BASE_URL=""

# Discord role sync — server id + role ids from the VGC Gemeinde server.
# All four must be set, otherwise the role sync is skipped entirely.
DISCORD_GUILD_ID="<guild id>"
DISCORD_ROLE_ID_DEV="<role id>"
DISCORD_ROLE_ID_ADMIN="<role id>"
DISCORD_ROLE_ID_STAFF="<role id>"

# --- Read by `supabase start` (env() substitution in supabase/config.toml) ---
# Changes here require a stack restart. Values: Discord Developer Portal → OAuth2.
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID="<client id>"
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET="<client secret>"

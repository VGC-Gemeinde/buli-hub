# Copy to .env and fill in. One file for everything local — read by Next.js,
# drizzle-kit and the scripts alike. The local stack is `npm run db:start`
# (compose.yaml: Postgres 17 + a Cloud Storage emulator).

# --- Read by the app / drizzle-kit ---

# Direct Postgres connection (Drizzle; the compose stack shown). The test
# suite and db:reset accept only a local host on port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# On Cloud Run only: the Cloud SQL socket directory
# (/cloudsql/<project>:europe-west1:<instance>). Empty locally.
DATABASE_SOCKET=""

# Connections per app instance. Production and staging share one small Cloud
# SQL instance (25 connections), so both run with 4 there. Unset → 10.
DATABASE_POOL_MAX=""

# Sign-in with Discord (specs/004-google-cloud-migration). Values: Discord
# Developer Portal → OAuth2. Register http://localhost:3000/auth/callback as a
# redirect there. The secret is server-side only.
DISCORD_CLIENT_ID="<client id>"
DISCORD_CLIENT_SECRET="<client secret>"

# Stream photos (Cloud Storage). Locally the emulator from compose.yaml; on
# Cloud Run STORAGE_API_URL stays unset and the real API is used.
# The bucket is private: the hub serves the photos at /stream-photos/<path>
# (owner and staff by session, the stream API by a signed address).
STORAGE_API_URL=http://localhost:4443
STREAM_PHOTOS_BUCKET=buli-hub-stream-photos

# Maintenance (contracts/maintenance.md): "on" answers every route with the
# maintenance page, except /impressum and /datenschutz.
# MAINTENANCE=on

# Discord REST API (bot token — server-side only, never expose to the client)
DISCORD_BOT_TOKEN="<dev bot token>"

# Optional: comma-separated hosts allowed to reach the dev server cross-origin
# (e.g. your phone on the LAN at http://192.168.x.x:3000). Without it, Next dev
# blocks cross-origin HMR/assets and the page loads but never hydrates.
DEV_LAN_ORIGIN=""

# Discord result channels — match results and MotW VOD announcements are
# posted here and kept in sync (edited/moved/deleted with the result). Three
# channels, the league's convention: results of Division 1 and 2, results of
# every other division, and the Match-of-the-Week announcements. All three
# unset → posting is skipped entirely, so local dev stays silent; only some
# set → misconfiguration, logged and skipped. The ids may be identical.
DISCORD_RESULTS_TOP_CHANNEL_ID=""
DISCORD_RESULTS_CHANNEL_ID=""
DISCORD_MOTW_CHANNEL_ID=""

# Session cookie for the whole Gemeinde domain (specs/004-google-cloud-migration,
# contracts/session.md). Production only (.vgcgemein.de) and only once another
# Gemeinde site reads the session; unset locally and on staging, where the
# cookie stays per host.
# AUTH_COOKIE_DOMAIN=""

# Public base URL of the hub (no trailing slash) — used for the "Zum Match"
# links in Discord posts. Unset → posts carry no hub link.
APP_BASE_URL=""

# Discord feedback forum — every bug report / idea from the app opens a forum
# post here. The channel may live in ANY guild the bot is a member of (it is
# addressed by channel id alone), so reports can sit on the staff server while
# DISCORD_GUILD_ID stays the main server. Unset → reports are still stored in
# the database, only no thread is created, so local dev stays silent.
DISCORD_FEEDBACK_FORUM_CHANNEL_ID=""

# Optional forum tag ids applied to new posts. Tag ids belong to their forum:
# moving the forum to another server means new ids here. Unset → posts are
# created untagged (the title still carries [Fehler] / [Idee]).
DISCORD_FEEDBACK_TAG_BUG=""
DISCORD_FEEDBACK_TAG_IDEA=""

# Commit the running instance was built from — reported with every bug report
# so "it worked yesterday" is answerable. Set by the deploy workflow; unset
# locally, where reports read "lokal".
APP_BUILD_SHA=""

# Discord role sync — server id + role ids from the VGC Gemeinde server.
# The first four must be set, otherwise the role sync is skipped entirely.
DISCORD_GUILD_ID="<guild id>"
DISCORD_ROLE_ID_DEV="<role id>"
DISCORD_ROLE_ID_ADMIN="<role id>"
DISCORD_ROLE_ID_STAFF="<role id>"
# Optional: the MOTW-Team's separate Discord role, granted the same staff
# access. Absent → only DISCORD_ROLE_ID_STAFF grants staff.
DISCORD_ROLE_ID_MOTW="<role id>"

# Discord season setup — group roles, private group channels and the
# Buli-Spieler ping role, created/assigned when the Spielplan is published
# and kept converged afterwards (docs/plans/discord-season-setup.md). The
# guild is resolved from the category, so local and staging point both at
# the TEST server. Both unset → the feature is skipped entirely.
DISCORD_LEAGUE_CATEGORY_ID=""
DISCORD_ROLE_ID_BULI_PLAYER=""

# Shared secret for scheduled job routes (/api/jobs/*), sent by Cloud
# Scheduler as "Authorization: Bearer <JOBS_SECRET>". Unset → the routes
# answer 503; the in-app triggers (publish, staff button) do not need it.
JOBS_SECRET=""

# Shared secret for the stream API (/api/stream/*), presented by
# gemeinde-streams as "Authorization: Bearer <STREAM_API_SECRET>". Unset → the
# routes answer 503. Its own secret, not JOBS_SECRET, so the two callers can
# be rotated apart.
STREAM_API_SECRET=""

# --- Cloning production (npm run db:clone-prod) ---

# Production through the Cloud SQL Auth Proxy
# (`cloud-sql-proxy --port 5433 <instance>`), e.g.
# postgresql://buli_hub:<password>@127.0.0.1:5433/buli_hub — read-only source
# for the clone. Unset → the clone script refuses to run.
PROD_DATABASE_URL=""

# Where the clone lands. Defaults to DATABASE_URL, i.e. the local stack.
# Only set this if you want a different target than the one you develop against.
CLONE_TARGET_DATABASE_URL=""

# Teamsheet sprites. Pokémon renders (animated .webp + still .png), box icons
# and item renders live in a public bucket, not in the repo — they are far too
# large. This is the bucket root; the app appends /pokemon, /pokemon-pixel and
# /items. Unset → the shared justhit.gg bucket, which is what production uses.
NEXT_PUBLIC_SPRITE_BASE=""

# Set to "staging" on the staging deployment only. Makes the app serve a
# disallow-all robots.txt and an X-Robots-Tag: noindex header, so the
# unlisted staging URL cannot end up in search results. Unset everywhere else.
APP_ENV=""

# --- Dev tooling outside `npm run dev` ---
# These two are what makes /dev reachable on staging. THEY MUST NEVER BE SET ON
# THE PRODUCTION CLOUD RUN SERVICE: together they allow signing in as any user.
# In local development /dev is on regardless and both are ignored.
ENABLE_DEV_TOOLS=""
DEV_TOOLS_TOKEN=""

# --- The move from Supabase (npm run db:move-from-supabase, one-time) ---
# contracts/switch-procedure.md. Source: the Supabase session string (5432).
# Target: the empty Cloud SQL database through the Auth Proxy.
SUPABASE_DATABASE_URL=""
MOVE_TARGET_DATABASE_URL=""
